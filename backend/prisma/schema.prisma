datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. IDENTITY & ACCESS
// -------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN, SALES_REP, SALES_MANAGER, FINANCE, WAREHOUSE, CUSTOMER
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  roleId          String
  role            Role             @relation(fields: [roleId], references: [id])
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  isActive        Boolean          @default(true)
  quotations      Quotation[]      @relation("UserQuotations")
  assignedApprovals Approval[]     @relation("AssignedApprovals")
  approvalActions ApprovalAction[]
  auditLogs       AuditLog[]
  payments        Payment[]
  negotiations    Negotiation[]
  quoteComments   QuoteComment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// -------------------------------------------------------------
// 2. CUSTOMER & PRICING
// -------------------------------------------------------------

model CustomerTier {
  id                 String        @id @default(uuid())
  name               String        @unique // Bronze, Silver, Gold
  maxDiscountPercent Float         // e.g. 5, 10, 15
  description        String?
  isActive           Boolean       @default(true)
  customers          Customer[]
  pricingRules       PricingRule[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Customer {
  id            String         @id @default(uuid())
  companyName   String
  contactName   String
  email         String         @unique
  phone         String?
  address       String?
  tierId        String
  tier          CustomerTier   @relation(fields: [tierId], references: [id])
  isActive      Boolean        @default(true)
  users         User[]
  quotations    Quotation[]
  orders        Order[]
  invoices      Invoice[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// -------------------------------------------------------------
// 3. PRODUCT & PRICING
// -------------------------------------------------------------

model ProductCategory {
  id            String         @id @default(uuid())
  name          String         @unique // Hardware, Services, Software, Subscriptions
  description   String?
  isActive      Boolean        @default(true)
  products      Product[]
  discountRules DiscountRule[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  categoryId         String
  category           ProductCategory     @relation(fields: [categoryId], references: [id])
  description        String?
  unit               String              @default("unit") // unit, hour, user/month
  basePrice          Float
  costPrice          Float               @default(0) // Used for real margin calculations
  taxPercent         Float               @default(18) // e.g. 18%
  productType        String              @default("ONE_TIME") // ONE_TIME, RECURRING
  billingInterval    String?             // MONTHLY, QUARTERLY, YEARLY (if recurring)
  isActive           Boolean             @default(true)
  pricingRules       PricingRule[]
  inventory          Inventory[]
  quotationItems     QuotationItem[]
  orderItems         OrderItem[]
  invoiceItems       InvoiceItem[]
  subscriptions      Subscription[]
  upsellSources      UpsellRule[]        @relation("UpsellSource")
  upsellSuggestions  UpsellRule[]        @relation("UpsellSuggested")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model PricingRule {
  id             String        @id @default(uuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  customerTierId String?
  customerTier   CustomerTier? @relation(fields: [customerTierId], references: [id])
  price          Float
  currency       String        @default("INR")
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model DiscountRule {
  id                 String          @id @default(uuid())
  categoryId         String
  category           ProductCategory @relation(fields: [categoryId], references: [id])
  maxDiscountPercent Float           // Category limit e.g. Hardware 15%, Service 10%
  approvalLevel      String          @default("SALES_MANAGER") // SALES_MANAGER, FINANCE, SALES_MANAGER_AND_FINANCE
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model UpsellRule {
  id                 String   @id @default(uuid())
  sourceProductId    String
  sourceProduct      Product  @relation("UpsellSource", fields: [sourceProductId], references: [id])
  suggestedProductId String
  suggestedProduct   Product  @relation("UpsellSuggested", fields: [suggestedProductId], references: [id])
  promotionTag       String?  // e.g. "HOT COMBO", "ESSENTIAL ADDON"
  priority           Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// -------------------------------------------------------------
// 4. WAREHOUSE & INVENTORY
// -------------------------------------------------------------

model Warehouse {
  id                 String                @id @default(uuid())
  name               String
  code               String                @unique // WH-MUM, WH-KOL, WH-DEL
  address            String
  shippingCostWeight Float                 @default(1.0) // 1.0 (cheapest), 1.4, etc.
  isActive           Boolean               @default(true)
  inventory          Inventory[]
  allocations        WarehouseAllocation[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model Inventory {
  id                String    @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  quantityAvailable Int       @default(0)
  reorderLevel      Int       @default(5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([warehouseId, productId])
}

model WarehouseAllocation {
  id           String    @id @default(uuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  quantity     Int
  shippingCost Float     @default(0)
  createdAt    DateTime  @default(now())
}

// -------------------------------------------------------------
// 5. DEAL LIFECYCLE (QUOTATION & RISK)
// -------------------------------------------------------------

model Quotation {
  id                    String          @id @default(uuid())
  quoteNumber           String          @unique // e.g. QT-2026-0001
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id])
  createdById           String
  createdBy             User            @relation("UserQuotations", fields: [createdById], references: [id])
  status                String          @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, NEGOTIATION, ACCEPTED, CANCELLED
  subtotal              Float           @default(0)
  discountAmount        Float           @default(0)
  taxAmount             Float           @default(0)
  totalAmount           Float           @default(0)
  totalMargin           Float           @default(0)
  riskScore             Float           @default(0) // Blended risk score (0 to 100)
  requiredApprovalLevel String          @default("NONE") // NONE, SALES_MANAGER, SALES_MANAGER_AND_FINANCE
  validUntil            DateTime?
  items                 QuotationItem[]
  approvals             Approval[]
  negotiations          Negotiation[]
  comments              QuoteComment[]
  order                 Order?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model QuotationItem {
  id              String         @id @default(uuid())
  quotationId     String
  quotation       Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  quantity        Int            @default(1)
  unitPrice       Float
  costPrice       Float          @default(0)
  discountPercent Float          @default(0)
  discountAmount  Float          @default(0)
  taxPercent      Float          @default(18)
  lineSubtotal    Float          @default(0)
  lineTotal       Float          @default(0)
  marginAmount    Float          @default(0)
  riskPoints      Float          @default(0)
  comments        QuoteComment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model QuoteComment {
  id                String         @id @default(uuid())
  quotationId       String
  quotation         Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationItemId   String?
  quotationItem     QuotationItem? @relation(fields: [quotationItemId], references: [id])
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  message           String
  isCustomerVisible Boolean        @default(true)
  createdAt         DateTime       @default(now())
}

model Approval {
  id            String           @id @default(uuid())
  quotationId   String
  quotation     Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approvalLevel String           // SALES_MANAGER, FINANCE, SALES_MANAGER_AND_FINANCE
  status        String           @default("PENDING") // PENDING, APPROVED, REJECTED
  assignedToId  String?
  assignedTo    User?            @relation("AssignedApprovals", fields: [assignedToId], references: [id])
  riskScore     Float            @default(0)
  reason        String
  actions       ApprovalAction[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ApprovalAction {
  id         String   @id @default(uuid())
  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // APPROVE, REJECT, REQUEST_CHANGES
  reason     String?
  createdAt  DateTime @default(now())
}

model Negotiation {
  id                      String    @id @default(uuid())
  quotationId             String
  quotation               Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  initiatedById           String
  initiatedBy             User      @relation(fields: [initiatedById], references: [id])
  previousDiscountPercent Float
  proposedDiscountPercent Float
  previousTotalAmount     Float
  proposedTotalAmount     Float
  riskScore               Float     @default(0)
  requiredApprovalLevel   String?
  status                  String    @default("PENDING") // PENDING, APPROVED, REJECTED, ACCEPTED, CANCELLED
  message                 String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// -------------------------------------------------------------
// 6. ORDERS & FULFILLMENT
// -------------------------------------------------------------

model Order {
  id             String          @id @default(uuid())
  orderNumber    String          @unique // e.g. ORD-2026-0001
  quotationId    String          @unique
  quotation      Quotation       @relation(fields: [quotationId], references: [id])
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  status         String          @default("CONFIRMED") // CONFIRMED, PROCESSING, FULFILLED, PARTIALLY_FULFILLED, CANCELLED
  subtotal       Float
  discountAmount Float           @default(0)
  taxAmount      Float           @default(0)
  totalAmount    Float
  items          OrderItem[]
  invoices       Invoice[]
  subscriptions  Subscription[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderItem {
  id                String                @id @default(uuid())
  orderId           String
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product               @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Float
  discountPercent   Float                 @default(0)
  discountAmount    Float                 @default(0)
  taxPercent        Float                 @default(18)
  lineTotal         Float
  fulfillmentStatus String                @default("PENDING") // PENDING, PARTIALLY_ALLOCATED, ALLOCATED, FULFILLED
  allocations       WarehouseAllocation[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

// -------------------------------------------------------------
// 7. BILLING & PAYMENTS
// -------------------------------------------------------------

model Invoice {
  id              String            @id @default(uuid())
  invoiceNumber   String            @unique // e.g. INV-2026-0001
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id])
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  status          String            @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  subtotal        Float
  taxAmount       Float             @default(0)
  totalAmount     Float
  dueDate         DateTime?
  issuedAt        DateTime          @default(now())
  paidAt          DateTime?
  items           InvoiceItem[]
  payments        Payment[]
  billingSchedule BillingSchedule[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Int
  unitPrice   Float
  taxPercent  Float    @default(18)
  lineTotal   Float
  createdAt   DateTime @default(now())
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentMethod String   // CASH, BANK_TRANSFER, CARD, UPI, OTHER
  reference     String?  // Cheque / UTR / Txn ID
  paymentDate   DateTime @default(now())
  recordedById  String
  recordedBy    User     @relation(fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())
}

model Subscription {
  id              String            @id @default(uuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id])
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  status          String            @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, EXPIRED
  billingInterval String            @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  quantity        Int               @default(1)
  unitPrice       Float
  startDate       DateTime          @default(now())
  endDate         DateTime?
  nextBillingDate DateTime
  cancelledAt     DateTime?
  schedules       BillingSchedule[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model BillingSchedule {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingDate    DateTime
  amount         Float
  status         String       @default("SCHEDULED") // SCHEDULED, INVOICED, PAID, CANCELLED
  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// -------------------------------------------------------------
// 8. AUDIT LOG & CONFIGURATION
// -------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // QUOTE_CREATED, DISCOUNT_APPLIED, APPROVAL_GRANTED, etc.
  entityType String   // Quotation, Order, Invoice, Payment, Subscription
  entityId   String
  details    String?  // JSON stringified context
  timestamp  DateTime @default(now())
}

model DealHealthConfig {
  id                        String   @id @default("default")
  stalledDaysThreshold      Int      @default(3) // Inactive for > 3 days = Stalled
  anomalyDiscountMultiplier Float    @default(1.5) // Discount > 1.5x rep's average = Anomaly
  updatedAt                 DateTime @updatedAt
}

{
  "name": "dealflow360",
  "version": "1.0.0",
  "private": true,
  "description": "DealFlow360 — Intelligent, Self-Governing B2B Sales Operations Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "seed": "npm --prefix backend run seed",
    "seed:demo": "npm --prefix backend run seed:demo",
    "reset:dev": "npm --prefix backend run reset:dev",
    "reset:demo": "npm --prefix backend run reset:demo"
  },
  "keywords": [
    "dealflow",
    "sales-operations",
    "cpq",
    "governance",
    "quotations",
    "billing",
    "fulfillment"
  ],
  "author": "",
  "license": "ISC"
}
